# SuiOutKit Environment Configuration
PORT=5000
# PUBLIC_URL=your-public-server-url  # Used for OPay redirect callbacks and webhook registration

# Redis - three connection modes
#   mode=local: uses REDIS_URL directly (default redis://localhost:6379) - Docker Redis
#   mode=demo:  REDIS_HOST as URL, falls back to REDIS_URL - hosted single-URL (Railway, Upstash)
#   mode=live:  uses individual REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, REDIS_TLS_ENABLED
REDIS_MODE=local
REDIS_URL=redis://localhost:6379
# REDIS_HOST=us1-xxxx.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password
# REDIS_TLS_ENABLED=true
# SESSION_TTL=86400

# FIAT PROVIDER: STRIPE
STRIPE_MODE=test  # test | live
STRIPE_PUBLIC_KEY_test=pk_test_...
STRIPE_SECRET_KEY_test=sk_test_...
STRIPE_WEBHOOK_SECRET_test=whsec_...
STRIPE_PUBLIC_KEY_live=pk_live_...
STRIPE_SECRET_KEY_live=sk_live_...
STRIPE_WEBHOOK_SECRET_live=whsec_...
# Flat fallback (backward compat) - suffixed vars above take priority
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Flutterwave API V3 (Charge Gateway)
FLW_API_BASE=https://api.flutterwave.com/v3
FLW_MODE=test  # test | live
FLW_PUBLIC_KEY_test=your_flutterwave_public_key_test
FLW_SECRET_KEY_test=your_flutterwave_secret_key_test
FLW_HASH_test=your_webhook_secret_hash_test
FLW_PUBLIC_KEY_live=your_flutterwave_public_key_live
FLW_SECRET_KEY_live=your_flutterwave_secret_key_live
FLW_HASH_live=your_webhook_secret_hash_live
# Flat fallback (backward compat) - suffixed vars above take priority
# FLW_PUBLIC_KEY=your_flutterwave_public_key
# FLW_SECRET_KEY=your_flutterwave_secret_key
# FLW_HASH=your_webhook_secret_hash

# Decentralized Invoice Store (Walrus) - network-specific URLs suffixed by SUI_NETWORK
# publisher uses the public Walrus publisher; sdk signs/registers/certifies with WALRUS_OPERATOR_PRIVATE_KEY.
WALRUS_UPLOAD_MODE=publisher
WALRUS_EPOCHS=5
WALRUS_DELETABLE=false
WALRUS_USE_UPLOAD_RELAY=false
WALRUS_UPLOAD_RELAY_URL_testnet=https://upload-relay.testnet.walrus.space
WALRUS_UPLOAD_RELAY_URL_mainnet=https://upload-relay.mainnet.walrus.space
WALRUS_UPLOAD_RELAY_MAX_TIP=1000
WALRUS_PUBLISHER_URL_testnet=https://publisher.walrus-testnet.walrus.space
WALRUS_PUBLISHER_URL_mainnet is not needed - mainnet uses SDK mode only

# Sui Ledger Connection - suffixed by SUI_NETWORK (testnet/mainnet)
SUI_NETWORK=testnet
SUI_GRPC_ENDPOINT_testnet=https://fullnode.testnet.sui.io:443
SUI_GRPC_ENDPOINT_mainnet=https://fullnode.mainnet.sui.io:443
SUI_GRAPHQL_ENDPOINT_testnet=https://graphql.testnet.sui.io/graphql
SUI_GRAPHQL_ENDPOINT_mainnet=https://graphql.mainnet.sui.io/graphql

# Contract Object IDs - suffixed by SUI_NETWORK (testnet/mainnet)
PACKAGE_ID_testnet=0x8c029c23e67a08bccec01c46dda9bb66a48eda8b72519dba3ca28504a4ddd507
PACKAGE_ID_mainnet=
PAYMENT_KIT_PACKAGE_ID_testnet=0x7e069abe383e80d32f2aec17b3793da82aabc8c2edf84abbf68dd7b719e71497
PAYMENT_KIT_PACKAGE_ID_mainnet=0xbc126f1535fba7d641cb9150ad9eae93b104972586ba20f3c60bfe0e53b69bc6
TREASURY_ID_testnet=0x380ff0431c17c34147854eadd33422fb5d165817679fb37668f82b84ba64cf3e
TREASURY_ID_mainnet=
FIAT_REGISTRY_ID_testnet=0x9023446c10d0db7a7ed50374cab5bd97859c6ff309c17d79067b376fb3533941
FIAT_REGISTRY_ID_mainnet=
FIAT_REGISTRY_ADMIN_CAP_ID_testnet=0x65e7f127806c57ca8851fae687e8a2f68233cfba5d74e7cc3148d52f7c49e32a
FIAT_REGISTRY_ADMIN_CAP_ID_mainnet=
CRYPTO_REGISTRY_NAME=suioutkit-crypto-settlements
CRYPTO_REGISTRY_ID_testnet=0xd08335554e2fb0e92dfce2707bd57195d7a21e80a1a0e8108e92fecf8da42ae8
CRYPTO_REGISTRY_ID_mainnet=
CRYPTO_REGISTRY_ADMIN_CAP_ID_testnet=0x899b703d08f66c472fe8b609443cde2eedfa0b3e3b1d65be753a8698420224c3
CRYPTO_REGISTRY_ADMIN_CAP_ID_mainnet=

# Operator Account Private Key (Ed25519 - Hex or Bech32 format)
SUI_OPERATOR_PRIVATE_KEY=
# Required when WALRUS_UPLOAD_MODE=sdk. Wallet must have SUI for gas and WAL for storage.
WALRUS_OPERATOR_PRIVATE_KEY=

# Settlement Payout parameters
# SUPPORTED_COINS_<NETWORK>: JSON map of symbol->{type,coingeckoId,decimals,category}
# Uses SUI_NETWORK env to select which config to load (testnet/mainnet).
# Falls back to SUPPORTED_COINS if network-specific not set, then to SUI-only default.
# Categories: "native" | "stablecoin" | "utility" | "defi"
#
# Testnet tokens:
#   SUI  - native
#   USDC - stablecoin (0xa1ec...::usdc::USDC)
#   DEEP - utility (0x36db...::deep::DEEP)
#   WAL  - utility (0x8270...::wal::WAL)
#
# Mainnet tokens:
#   SUI    - native
#   USDC   - stablecoin (0xdba3...::usdc::USDC)
#   USDT   - stablecoin (0x375f...::usdt::USDT)
#   USDSui - stablecoin (0x44f8...::usdsui::USDSUI)
#   eSUID  - stablecoin (0x41d5...::sui_usde::SUI_USDE)
#   WAL    - utility (0x356a...::wal::WAL)
#   DEEP   - utility (0xdeeb...::deep::DEEP)
#   CETUS  - defi (0x0686...::cetus::CETUS)
#   SuiNS  - utility (0x5145...::ns::NS)
#
# SUPPORTED_COINS_TESTNET='{"SUI":{"type":"0x2::sui::SUI","coingeckoId":"sui","decimals":9,"category":"native"},"USDC":{"type":"0xa1ec...::usdc::USDC","coingeckoId":"usd-coin","decimals":6,"category":"stablecoin"},"DEEP":{"type":"0x36db...::deep::DEEP","coingeckoId":"deepbook","decimals":6,"category":"utility"},"WAL":{"type":"0x8270...::wal::WAL","coingeckoId":"walrus-2","decimals":9,"category":"utility"}}'
# SUPPORTED_COINS_MAINNET='{"SUI":{"type":"0x2::sui::SUI","coingeckoId":"sui","decimals":9,"category":"native"},"USDC":{"type":"0xdba3...::usdc::USDC","coingeckoId":"usd-coin","decimals":6,"category":"stablecoin"},"USDT":{"type":"0x375f...::usdt::USDT","coingeckoId":"tether","decimals":6,"category":"stablecoin"},"USDSui":{"type":"0x44f8...::usdsui::USDSUI","coingeckoId":"usdsui","decimals":6,"category":"stablecoin"},"eSUID":{"type":"0x41d5...::sui_usde::SUI_USDE","coingeckoId":"esui-dollar","decimals":6,"category":"stablecoin"},"WAL":{"type":"0x356a...::wal::WAL","coingeckoId":"walrus-2","decimals":9,"category":"utility"},"DEEP":{"type":"0xdeeb...::deep::DEEP","coingeckoId":"deepbook","decimals":6,"category":"utility"},"CETUS":{"type":"0x0686...::cetus::CETUS","coingeckoId":"cetus-protocol","decimals":9,"category":"defi"},"SuiNS":{"type":"0x5145...::ns::NS","coingeckoId":"suins-token","decimals":6,"category":"utility"}}'
# SUPPORTED_COINS='{"SUI":{"type":"0x2::sui::SUI","coingeckoId":"sui","decimals":9,"category":"native"}}'  # legacy fallback
DEFAULT_COIN=SUI

# Fiat Currency Configuration
# DEFAULT_CURRENCY is used when no currency is specified and geo detection is disabled.
# SUPPORTED_FIAT_CURRENCIES limits which fiat currencies are accepted (comma-separated codes, empty = all 40+).
# ENABLE_GEO_DETECTION enables IP-based country detection to auto-resolve the user's fiat currency.
DEFAULT_CURRENCY=USD
# SUPPORTED_FIAT_CURRENCIES=NGN,USD,GBP,EUR
# ENABLE_GEO_DETECTION=false

# FX Rate Configuration
# COINGECKO_API_MODE selects which API tier to use: "demo" or "pro" (default: none = free, no key needed).
# Demo API key gives higher rate limits on the free endpoint (api.coingecko.com).
# Pro API key gives highest limits on the paid endpoint (pro-api.coingecko.com).
# FX_CACHE_TTL controls how long (ms) CoinGecko prices are cached in memory (default: 30000).
COINGECKO_API_MODE=demo
COINGECKO_API_KEY_DEMO=
COINGECKO_API_KEY_PRO=
FX_CACHE_TTL=30000
